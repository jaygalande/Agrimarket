# Copy this file to backend/.env for local development.
# Backend Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Replace with your actual MongoDB Atlas connection string in your local .env file
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/farmer_db?retryWrites=true&w=majority

# Security & Authentication
# Choose a strong random string for your local signing token
JWT_SECRET=your_super_secret_jwt_key_here

# Admin setup: run `npm run admin:create` from the project root for local setup.
# Production creates this Admin automatically during backend startup.
# Use a unique password with at least 12 characters.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_long_random_password